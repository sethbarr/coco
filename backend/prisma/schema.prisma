// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  // native for local dev; debian target for Railway's container runtime
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Make sure this points to your Supabase DB
  directUrl = env("DIRECT_URL")   // For migrations if needed
}

model RefreshToken {
  id         String    @id @default(uuid())
  token      String    @unique
  userId     String
  expiresAt  DateTime
  invalid    Boolean   @default(false)
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  
  // Relationships
  user       User      @relation("UserRefreshTokens", fields: [userId], references: [id])
}

model User {
  id           String       @id @default(uuid())
  pseudonym    String
  authId       String       @unique
  publicKey    Json
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  lastActive   DateTime?
  deletedAt    DateTime?
  
  // Relationships
  createdConnections Connection[] @relation("CreatorConnections")
  receivedConnections Connection[] @relation("RecipientConnections")
  createdSessions Session[] @relation("CreatedBy")
  participatedSessions SessionParticipant[]
  messages Message[] @relation("SenderMessages")
  refreshTokens RefreshToken[] @relation("UserRefreshTokens")
  securityEvents SecurityEvent[] @relation("UserSecurityEvents")
  createdTopics Topic[] @relation("TopicCreator")
  sharedSummaries SharedSummary[] @relation("UserSummaries")

}

model Connection {
  id               String     @id @default(uuid())
  creatorId        String
  recipientId      String
  relationshipType String
  status           String     // 'pending', 'active', 'declined'
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  // Relationships
  creator          User       @relation("CreatorConnections", fields: [creatorId], references: [id])
  recipient        User       @relation("RecipientConnections", fields: [recipientId], references: [id])
  topics           Topic[]

  @@unique([creatorId, recipientId])
}

model Topic {
  id            String    @id @default(uuid())
  title         String
  connectionId  String
  createdById   String
  status        String    @default("prep") // 'prep', 'joint_ready', 'closed'
  nextCheckInAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relationships
  connection Connection      @relation(fields: [connectionId], references: [id])
  createdBy  User            @relation("TopicCreator", fields: [createdById], references: [id])
  summaries  SharedSummary[]
  sessions   Session[]
  recaps     SessionRecap[]
  agreements Agreement[]
}

model SessionRecap {
  id                    String   @id @default(uuid())
  sessionId             String   @unique
  topicId               String
  summary               String
  suggestedCheckInDays  Int?
  endorsements          Json     @default("{}") // { userId: ISO timestamp }
  createdAt             DateTime @default(now())

  // Relationships
  session    Session     @relation(fields: [sessionId], references: [id])
  topic      Topic       @relation(fields: [topicId], references: [id])
  agreements Agreement[]
}

model Agreement {
  id        String   @id @default(uuid())
  topicId   String
  recapId   String
  text      String
  ownerId   String?  // null = shared agreement; set = one partner's commitment
  status    String   @default("proposed") // 'proposed', 'active', 'kept', 'struggling', 'retired'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  topic Topic        @relation(fields: [topicId], references: [id])
  recap SessionRecap @relation(fields: [recapId], references: [id])
}

model SharedSummary {
  id         String    @id @default(uuid())
  topicId    String
  userId     String
  content    String
  approvedAt DateTime? // null = draft; editing clears approval
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relationships
  topic Topic @relation(fields: [topicId], references: [id])
  user  User  @relation("UserSummaries", fields: [userId], references: [id])

  @@unique([topicId, userId])
}

model Session {
  id          String    @id @default(uuid())
  type        String    // 'individual' or 'joint'
  createdById String
  topicId     String?   // set when this session is part of a guided topic
  createdAt   DateTime  @default(now())
  endedAt     DateTime?

  // Relationships
  createdBy  User       @relation("CreatedBy", fields: [createdById], references: [id])
  topic      Topic?     @relation(fields: [topicId], references: [id])
  participants SessionParticipant[]
  messages   Message[]
  recap      SessionRecap?
}

model SessionParticipant {
  sessionId String
  userId    String
  joinedAt  DateTime @default(now())
  
  // Relationships
  session   Session  @relation(fields: [sessionId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  
  @@id([sessionId, userId])
}

model Message {
  id                 String   @id @default(uuid())
  sessionId          String
  senderId           String
  isAi               Boolean  @default(false)
  encryptedContent   String
  encryptionMetadata Json
  sentAt             DateTime @default(now())
  
  // Relationships
  session            Session  @relation(fields: [sessionId], references: [id])
  sender             User     @relation("SenderMessages", fields: [senderId], references: [id])
}

model SecurityEvent {
  id         String   @id @default(uuid())
  userId     String
  eventType  String
  metadata   Json
  createdAt  DateTime @default(now())
  
  // Relationship
  user       User     @relation("UserSecurityEvents", fields: [userId], references: [id])
}
